        <api_name>x_1329491_training.repeatCourseSameDate</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>It should not be possible to schedule a training session for any course on a date that already has a training session for the same course</description>
        <mobile_callable>false</mobile_callable>
        <name>repeatCourseSameDate</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CheckTrainingAvailability = Class.create();
CheckTrainingAvailability.prototype = {
    initialize: function() {
    },

    checkAvailability: function(training, date) {
        var gr = new GlideRecord('x_1329491_training_training_calendar');
        gr.addQuery('training', training);
        gr.addQuery('date', date);
        gr.query();
        return gr.next(); // Retorna true se encontrar um registro
    }
};

]]></script>
