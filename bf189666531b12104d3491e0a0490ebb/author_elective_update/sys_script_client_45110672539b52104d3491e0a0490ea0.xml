        <condition/>
        <description/>
        <field>date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Show Duplicate error message</name>
        <order/>
        <script><![CDATA[function onChange(newValue, isLoading) {
   if (isLoading || newValue === '') {
      return;
   }
 
   var training = g_form.getValue("training");
   var date = g_form.getValue("date");
 
   if (!training || !date) {
      return;
   }
 
   date = convertToSystemDate(date);
 
   var ga = new GlideAjax("duplicateCourseDate");
   ga.addParam('sysparm_name', 'checkDuplicateSchedule');
   ga.addParam('sysparm_course', training);
   ga.addParam('sysparm_date', date);
 
   ga.getXMLAnswer(function(answer) {
      if (answer === 'true') {
         g_form.setValue("date", "");
         g_form.showErrorBox("date","Já existe um treinamento deste curso agendado para esta data", true);
      }
   });
}
 
function convertToSystemDate (dateStr) {
 
    var parts = dateStr.split('/');
    if (parts.length === 3) {
 
        return parts[2] + '-' + parts[1] + '-' + parts[0];
    }
 
    return dateStr;
}
 ]]></script>
