        <mobile_callable>false</mobile_callable>
        <name>userCalendarFilter</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var userCalendarFilter = Class.create();
userCalendarFilter.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    initialize: function() {},

    getAvailableCourses: function() {
		var currentUser = gs.getUserID();
        var dados = [];
        var today = new GlideDate();
		today.setValue(new GlideDateTime().getLocalDate().toString());
		var currentDate = today.getValue();

        var trainingCalendar = new GlideRecord('x_1329491_training_training_calendar');
        trainingCalendar.addQuery('date', '>', today);
        trainingCalendar.addQuery('instructor', '!=', currentUser);
        trainingCalendar.query();

        while (trainingCalendar.next()) {
            var calendarId = trainingCalendar.getUniqueValue();

            var registrations = new GlideRecord('x_1329491_training_registration');
            registrations.addQuery('training', calendarId);
            registrations.addQuery('state', '!=', '4');
            registrations.query();

            if (registrations.getRowCount() < trainingCalendar.available_seats) {
                var courseCount = new GlideAggregate('x_1329491_training_registration');
                courseCount.addQuery('training', trainingCalendar.training);
                courseCount.addQuery('opened_by', currentUser);
                courseCount.addQuery('state', '!=', '4');
                courseCount.addAggregate('COUNT');
                courseCount.query();

                if (courseCount.next() && courseCount.getAggregate('COUNT') < 3) {
                    var sameDayRegistrations = new GlideRecord('x_1329491_training_registration');
                    sameDayRegistrations.addQuery('training', calendarId);
                    sameDayRegistrations.addQuery('opened_by', currentUser);
                    sameDayRegistrations.addQuery('state', '!=', '4');
                    sameDayRegistrations.query();

                    if (!sameDayRegistrations.hasNext()) {
                        dados.push({
                            sys_id: calendarId,
                            nome: trainingCalendar.getDisplayValue('default_value')
                            //data: trainingCalendar.data_curso.toString()
                        });
                    }
                }
            }
        }
        return JSON.stringify(dados);
    },

    type: 'userCalendarFilter'
});]]></script>
