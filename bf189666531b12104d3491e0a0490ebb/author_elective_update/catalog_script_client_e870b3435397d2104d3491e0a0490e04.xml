        <script><![CDATA[function onSubmit() {

var ga = new GlideAjax('userCalendarFilter');
    ga.addParam('sysparm_name', 'getAvailableCourses');
    ga.addParam('sysparm_user', g_user.userID);
    
    ga.getXML(processResponse);

    function processResponse(response) {
    //try {
        // Extrair a string JSON do XML de resposta usando o atributo 'answer'
        var answer = response.responseXML.documentElement.getAttribute("answer");
        var availableTrainings = JSON.parse(answer); // Parse o JSON para um objeto JavaScript

    // Remove "sys_idIN" e divide a string para obter os IDs
    //var availableTrainings = response.substring(8).split(',');

    var selectedCalendar = g_form.getValue('training');
    
    if (availableTrainings.indexOf(selectedCalendar) === -1) {
      // Exibe a mensagem de erro se o calendário não estiver na lista permitida
      g_form.addErrorMessage('Você não pode se inscrever nesse calendário.');
      // Impedir submissão do formulário
      return false;
    }
    
    // Se o calendário estiver na lista, permite a submissão
    g_form.addInfoMessage('Inscrição bem-sucedida.');
    g_form.submit();
  }

  // Retorne false inicialmente para aguardar a resposta do GlideAjax
  return false;
}
]]></script>
