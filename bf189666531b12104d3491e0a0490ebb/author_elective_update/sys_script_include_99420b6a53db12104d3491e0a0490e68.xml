    <sys_script_include action="DELETE">
        <access>package_private</access>
        <active>false</active>
        <api_name>x_1329491_training.duplicateCourseDate</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description>It should not be possible to schedule a training session for any course on a date that already has a training session for the same course</description>
        <mobile_callable>false</mobile_callable>
        <name>duplicateCourseDate</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var duplicateCourseDate = Class.create();
duplicateCourseDate.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    checkDuplicateSchedule: function() {
        var training = this.getParameter("sysparm_course");
        var date = this.getParameter("sysparm_date");
 
        var gr = new GlideRecord("x_1329491_training_training_calendar");
        gr.addQuery('training', training);
        gr.addQuery('date', date);
        gr.query();
         
        if (gr.next()) {
            return 'true';
 
        }
 
        return 'false';
    },
 
    convertToSystemDate: function (dateStr) {
 
        var parts = dateStr.split('/');
 
        if (parts.length === 3) {
 
            return parts[2] + '-' + parts[1] + '-' + parts[0];      
        }
 
        return dateStr;
    },
 
    type: 'duplicateCourseDate'
});]]></script>
