        <api_name>x_1329491_training.getTrainingInstructorRole</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>This script includes defines a class that can be used to retrieve users assigned with a specific training instructor role in ServiceNow</description>
        <mobile_callable>false</mobile_callable>
        <name>getTrainingInstructorRole</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var getTrainingInstructorRole = Class.create();
getTrainingInstructorRole.prototype = {
    initialize: function() {
    },
	getInstructorUser : function() {
		var roleG = new GlideRecord('sys_user_has_role');
		roleG.addEncodedQuery('role.name=x_1329491_training.instructor^state=active');
		roleG.query();

		var instructorUser = [];

		while(roleG.next()) {
			instructorUser.push(roleG.getValue('user'));
		}

		return 'sys_idIN' + instructorUser;
	},

    type: 'getTrainingInstructorRole'
};]]></script>
